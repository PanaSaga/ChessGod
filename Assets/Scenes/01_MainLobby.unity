  dialogueSlide: {fileID: 1048700552}
  dialogueText: {fileID: 627404908}
  lines:
  - dialogue: "\uC544\uD558\uD558! \uC774\uB798\uC11C \uD751\uC758 \uB098\uB77C \uB188\uB4E4\uC740!\n\uACE0\uC791
      \uADF8\uC815\uB3C4 \uC7A5\uB09C\uC73C\uB85C \uC5BC\uBE60\uC9C0\uAE30\uB294."
    sprite: {fileID: 21300000, guid: de8db87116245a749b1aaaa0e5534a86, type: 3}
  - dialogue: "\uC73C\uC545?!"
    sprite: {fileID: 21300000, guid: 9500e50e46555044196e7da107e34f03, type: 3}
  - dialogue: "\uC2AC\uC2AC \uBAB8\uC774 \uADFC\uC9C8\uAC70\uB9AC\uB294\uB370.\n\uC9C0\uAE08
      \uCBE4\uC774\uBA74 \uC6C0\uC9C1\uC5EC\uB3C4 \uB418\uC9C0 \uC54A\uC544?"
    sprite: {fileID: 21300000, guid: 006739bf7971c344f91c408d7f1d6717, type: 3}
  - dialogue: "\uAC70\uAE30\uC11C \uB10B\uB193\uACE0 \uC788\uC9C0 \uB9D0\uACE0 \uC774\uB9AC
      \uC640!\n\uB098 \uC2EC\uC2EC\uD558\uB2E8\uB9D0\uC57C!"
    sprite: {fileID: 21300000, guid: f77ff27093240f94797c65fb28f3e5be, type: 3}
  displayDuration: 5
